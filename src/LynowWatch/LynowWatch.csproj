<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>LynowWatch</AssemblyName>
    <RootNamespace>LynowWatch</RootNamespace>
    <ApplicationIcon>..\..\assets\lynowwatch.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LynowWatch.Core\LynowWatch.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\exemplos\lynowwatch.json" Link="lynowwatch.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
